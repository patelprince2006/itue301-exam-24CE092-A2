# ==========================================
# QUICKBITE FULL-STACK ENVIRONMENT SETUP (RENDER)
# ==========================================

# 1. BACKEND SERVICE ENVIRONMENT VARIABLES (server/.env)
# ----------------------------------------------------
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickbite?retryWrites=true&w=majority
JWT_SECRET=quickbite_production_secret_key_change_me
CORS_ORIGIN=*

# 2. FRONTEND CLIENT ENVIRONMENT VARIABLES (client/.env)
# ----------------------------------------------------
# Set VITE_API_URL in Render Static Site Environment Settings
VITE_API_URL=https://your-backend-app.onrender.com/api/v1
