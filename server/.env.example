# Backend Environment Variables Template for Render Deployment
# Set PORT dynamically by Render (or default to 5000)
PORT=5000

# MongoDB Atlas Connection URI for Production Deployment
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickbite?retryWrites=true&w=majority

# Secret key for JWT token signing (change to a random strong string in production)
JWT_SECRET=quickbite_production_secret_key_change_me

# Allowed CORS Origin for Frontend Client (e.g., https://your-frontend-app.onrender.com or *)
CORS_ORIGIN=*
